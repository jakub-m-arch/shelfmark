{
  "name": "obsidian-shelfmark",
  "version": "1.0.0",
  "private": true,
  "description": "A personal library for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.14.4",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
